{
  "manifest_version": 3,
  "name": "WhatsApp Web Deluxe",
  "version": "1.0.0",
  "description": "WhatsApp Web in its own window, with an unread badge on the toolbar. Tiny, no tracking, no data collected.",
  "action": {
    "default_title": "Open WhatsApp Deluxe",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "scripts": [
      "ff-compat.js",
      "background.js"
    ]
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "whatsapp-web-deluxe@barraco002",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
